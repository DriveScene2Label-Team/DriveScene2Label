diff --git a/src/pointcloud/visibility_filter.py b/src/pointcloud/visibility_filter.py
new file mode 100644
index 0000000..b86f7f4
--- /dev/null
+++ b/src/pointcloud/visibility_filter.py
@@ -0,0 +1,81 @@
+"""DriveScene2Label P2: drop LiDAR points that a camera mask picks up but the camera cannot actually see.
+
+A segmentation mask is 2D, so reprojecting it onto LiDAR collects every point that projects inside it,
+whatever its depth: background seen past the object's silhouette, the far side of the road, other
+objects behind it. Two numpy-only filters remove them before the box is fitted:
+
+1. Occlusion (z-buffer): the mask is split into cell_px x cell_px image cells. In each cell only points
+   within occlusion_margin_m of the nearest point are kept; anything further is hidden behind it.
+2. Depth extent: an object cannot be deeper than its class allows. Points more than max_extent_m
+   (diagonal of the class length_max/width_max) behind the object's near surface are dropped. The near
+   surface is a low percentile of the depths, so a single stray close point does not set it.
+
+If filtering would remove every point the original mask is returned unchanged.
+"""
+from typing import Mapping, Optional
+
+import numpy as np
+
+
+def camera_depth(
+    pointcloud: np.ndarray,
+    world_to_ego_lidar: np.ndarray,
+    world_to_ego_camframe: np.ndarray,
+    camera_to_image: np.ndarray,
+    ego_to_camera: np.ndarray,
+    ego_to_lidar: np.ndarray,
+) -> np.ndarray:
+    """Camera-frame depth (m) of each LiDAR point, same transform chain as _reproject_pointcloud_to_image.
+
+    Takes the same (batched, one camera) arguments as that function and returns shape (N,).
+    """
+    lidar_to_img = camera_to_image @ ego_to_camera @ world_to_ego_camframe \
+        @ np.linalg.inv(world_to_ego_lidar) @ np.linalg.inv(ego_to_lidar)
+    points_in_cam = lidar_to_img @ np.vstack([pointcloud.T, np.ones(pointcloud.shape[0])])
+    return points_in_cam[0, 2, :]
+
+
+def occlusion_mask(depth: np.ndarray, uv: np.ndarray, cell_px: int, margin_m: float) -> np.ndarray:
+    """Keep points within margin_m of the nearest point in their image cell."""
+    if depth.size == 0:
+        return np.zeros(0, dtype=bool)
+    cells = np.floor(uv / cell_px).astype(np.int64)
+    _, cell_id = np.unique(cells, axis=0, return_inverse=True)
+    cell_id = cell_id.reshape(-1)
+    nearest = np.full(cell_id.max() + 1, np.inf)
+    np.minimum.at(nearest, cell_id, depth)
+    return depth <= nearest[cell_id] + margin_m
+
+
+def depth_extent_mask(depth: np.ndarray, max_extent_m: float, near_percentile: float) -> np.ndarray:
+    """Keep points no more than max_extent_m behind the object's near surface."""
+    if depth.size == 0:
+        return np.zeros(0, dtype=bool)
+    near = np.percentile(depth, near_percentile)
+    return depth <= near + max_extent_m
+
+
+def filter_object_points(
+    depth: np.ndarray,
+    uv: np.ndarray,
+    max_extent_m: Optional[float],
+    cell_px: int = 8,
+    occlusion_margin_m: float = 1.5,
+    near_percentile: float = 5.0,
+) -> np.ndarray:
+    """Boolean keep-mask over one object's points (depth (N,), uv (N, 2)). Never returns all-False for N > 0."""
+    keep = occlusion_mask(depth, uv, cell_px, occlusion_margin_m)
+    if max_extent_m is not None and keep.any():
+        idx = np.flatnonzero(keep)
+        keep[idx[~depth_extent_mask(depth[idx], max_extent_m, near_percentile)]] = False
+    if depth.size and not keep.any():
+        return np.ones_like(keep)
+    return keep
+
+
+def class_max_extent(obj_infos: Mapping[str, object], sam_label: str) -> Optional[float]:
+    """Diagonal of the class length_max x width_max: the deepest the object can appear from any view."""
+    info = obj_infos.get(sam_label)
+    if info is None:
+        return None
+    return float(np.hypot(info.length_max, info.width_max))
