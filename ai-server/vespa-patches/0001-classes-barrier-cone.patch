diff --git a/assets/common_obj_infos.yaml b/assets/common_obj_infos.yaml
index 1b77073..037326d 100755
--- a/assets/common_obj_infos.yaml
+++ b/assets/common_obj_infos.yaml
@@ -114,3 +114,34 @@ bicycle:
   speed_max: 9.0
   speed_avg_hw: 5.0
   speed_max_hw: 9.0
+# DriveScene2Label: from nuScenes v1.0-mini GT boxes with lidar points (barrier n=1770, trafficcone n=803):
+# min/avg/max = p5/median/p95, length = longer horizontal side. Static classes: speeds are kept below
+# yaw_heuristic.speed_threshold so tracking noise never sets their yaw.
+barrier:
+  width_min: 0.4
+  width_max: 0.75
+  width_avg: 0.65
+  height_min: 0.9
+  height_max: 1.25
+  height_avg: 1.05
+  length_min: 1.85
+  length_max: 3.3
+  length_avg: 2.05
+  speed_avg: 0.3
+  speed_max: 0.3
+  speed_avg_hw: 0.3
+  speed_max_hw: 0.3
+traffic_cone:
+  width_min: 0.35
+  width_max: 0.55
+  width_avg: 0.45
+  height_min: 0.65
+  height_max: 1.3
+  height_avg: 0.75
+  length_min: 0.35
+  length_max: 0.85
+  length_avg: 0.45
+  speed_avg: 0.3
+  speed_max: 0.3
+  speed_avg_hw: 0.3
+  speed_max_hw: 0.3
diff --git a/configs/vlm/p_final.yaml b/configs/vlm/p_final.yaml
index 572deec..193e77f 100755
--- a/configs/vlm/p_final.yaml
+++ b/configs/vlm/p_final.yaml
@@ -21,7 +21,8 @@ remove_ground:
   rangefilter_sky_threshold: 4 # meters
   rangefilter_range_threshold: 55 # meters
 grounding_sam:
-  class_names: ["car", "truck", "bus", "trailer", "excavator", "pedestrian", "motorcycle", "bicycle"]
+  # DriveScene2Label: barrier and traffic cone added (static classes, nuScenes detection classes).
+  class_names: ["car", "truck", "bus", "trailer", "excavator", "pedestrian", "motorcycle", "bicycle", "barrier", "traffic cone"]
   detector: "IDEA-Research/grounding-dino-base"
   det_threshold: 0.3
   segmentator: "facebook/sam-vit-base"
@@ -63,6 +64,8 @@ velocity_by_app_tracking:
     "pedestrian": "max"
     "motorcycle": "avg"
     "bicycle": "max"
+    "barrier": "avg"
+    "traffic cone": "avg"
   compatible_class_groups:
     - ["car", "truck", "bus"]
     - ["truck", "trailer"]
diff --git a/src/labeling/assign_labels.py b/src/labeling/assign_labels.py
index 38a4dfb..cfe74fc 100755
--- a/src/labeling/assign_labels.py
+++ b/src/labeling/assign_labels.py
@@ -175,6 +175,8 @@ def get_scene_pseudo_annotations_by_mapping(
             annotations: List[Annotation] = []
             for obj in frame.objects:
                 obj_class = obj.pseudo_labels[mapping_name]
+                if obj_class is None:  # DriveScene2Label: class not in this mapping (e.g. barrier in 3class)
+                    continue
                 translation = (np.linalg.inv(frame.world_to_ego) @ np.linalg.inv(scene_w_labcluster.ego_to_lidar) \
                                @ obj.bbox_to_lidar @ np.array([0, 0, obj.bbox_dims[2]/2, 1]))[:3]
                 yaw = get_bbox_yaw(np.linalg.inv(frame.world_to_ego) @ np.linalg.inv(scene_w_labcluster.ego_to_lidar) @ obj.bbox_to_lidar)
