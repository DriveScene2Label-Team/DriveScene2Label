# Copy to .env.local for local overrides. Only read by the Vite dev/preview server, never shipped to the browser.
# Spring Boot base URL that `/api/*` is proxied to. FastAPI/DB addresses never belong here.
API_PROXY_TARGET=http://127.0.0.1:8080

# Vercel Project Settings only (not VITE_*, never an AWS/DB credential):
# BACKEND_URL=https://your-authenticated-api-domain
# Root Directory: frontend; see ../docs/hybrid-setup.md.
# Vercel only: VITE_AUTH_REQUIRED=true (public UI flag, no secret).
