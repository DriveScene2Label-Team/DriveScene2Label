# Copy to .env.hybrid. Empty required values deliberately prevent accidental startup.
# This file does not create, restore or start AWS resources.
COMPOSE_PROJECT_NAME=drivescene-hybrid
APP_PORT=8080
AWS_REGION=ap-northeast-2
NUSCENES_VERSION=v1.0-mini

# Use the reachable RDS hostname, with TLS hostname verification.
# The backend image already includes /app/rds-ca.pem.
# DB_URL=jdbc:postgresql://RDS_HOST:5432/drivescene?sslmode=verify-full&sslrootcert=/app/rds-ca.pem&reWriteBatchedInserts=true&connectTimeout=10&socketTimeout=120
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Existing private bucket containing uploads/<dataset-key>.zip.
UPLOAD_S3_BUCKET=
# Absolute host path to a dedicated shared-credentials file, mounted read-only.
# Use forward slashes on Windows, e.g. C:/Users/User/.aws/drivescene-credentials.
# Temporary credentials need aws_session_token; refresh the file when they expire.
# An SSO-only config profile is not a shared-credentials file.
AWS_SHARED_CREDENTIALS_HOST_PATH=
# Directory containing a scoped, refreshable session.json for credential_process.
AWS_CREDENTIALS_DIRECTORY=
AWS_PROFILE=default
HYBRID_AUTH_ENV_PATH=
MODEL_CACHE_VOLUME=drivescene-hybrid_model_cache
# Set true when reusing an existing model cache owned by another Compose project.
MODEL_CACHE_EXTERNAL=false

# Keep disabled until the restored DB and pending jobs have been reviewed.
AUTO_LABEL_WORKER_ENABLED=false
UPLOAD_WORKER_ENABLED=false
EMBEDDING_INDEX_WORKER_ENABLED=false
RECORDING_WORKER_ENABLED=false
VESPA_NUM_THREADS=1
VESPA_TIMEOUT_SECONDS=7200
AUTO_LABEL_READ_TIMEOUT=7300s
AI_SERVER_READ_TIMEOUT=30s
RECORDING_TIMEOUT_SECONDS=600
RECORDING_READ_TIMEOUT=660s
